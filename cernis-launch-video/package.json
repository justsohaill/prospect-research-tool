{
  "name": "cernis-launch-video",
  "private": true,
  "version": "1.0.0",
  "description": "HTML/CSS launch video for cernis.ai, rendered frame by frame with headless Chromium and encoded with ffmpeg.",
  "scripts": {
    "assets": "node scripts/gen-assets.js",
    "captions": "node scripts/check-captions.js",
    "stills": "node scripts/render.js --stills 13.6,24.9,28.7,40.4,64",
    "music": "node scripts/make-music.js",
    "render": "node scripts/make-music.js && node scripts/render.js --all --audio out/music.wav"
  },
  "devDependencies": {
    "lucide-static": "^0.460.0",
    "simple-icons": "9.21.0"
  }
}
